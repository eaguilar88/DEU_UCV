HTTP_SERVE_PORT=8081
# Public HTTPS base URL for this backend, used to build file/image URLs
# (must resolve to GET /files/*key over HTTPS, e.g. https://api.extension.ucv.ve/files)
# Defaults to http://localhost:8080 if unset — do NOT leave unset in production,
# or served images will point at localhost and fail as mixed content in browsers.
# For local development use http://localhost:8081/files.
APP_BASE_URL="https://extension.ucv.ve/files"
# Comma-separated list of origins allowed to call this API from a browser (CORS).
# Defaults to http://localhost:3000 for local frontend dev.
# In production, list every frontend origin explicitly — never "*".
ALLOWED_ORIGINS="https://grupos.extension.ucv.ve,https://formacion.extension.ucv.ve"
# Public base URL of the certificate verification pages (/certificados/...): encoded in the
# certificates' QR codes and in the links emailed to course owners. Unlike APP_BASE_URL it has
# no /files suffix. Defaults to http://localhost:8080.
PUBLIC_BASE_URL="https://extension.ucv.ve"
# Gotenberg server used to render certificates to PDF. Defaults to http://gotenberg:3000 (the
# compose service); use http://localhost:3001 when running the backend with `go run`.
GOTENBERG_URL="http://gotenberg:3000"
JWT_SIGNING_KEY="5Sm0wEm+zZBLhiZzGYeAiTehKfgnrgmBOxdOOW2LVL8="
TOKEN_TTL=3600
FLAVOR=dev

# -- Rails Landing (deu-app) --
RAILS_ENV=production
LANDING_PORT=3000
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1
SECRET_KEY_BASE=320ccf43bab76ed3c5af0e63dcdfcc4ce794e4f4af7c3260f4d8dc68cd4c8b6f3b7e068246c53544e3cc26c6e65354ba4ee3fe715aa74220b3eb7bcb728931a1
RAILS_FORCE_SSL=false
DEU_SEED_PASSWORD=123123
DEU_SUPER_ADMIN_EMAILS=admin@ucv.ve

# -- Database Config --
POSTGRES_HOST=db
POSTGRES_DB=deu
POSTGRES_USER=deu_admin
POSTGRES_PASSWORD=nolodire
POSTGRES_PORT=5432

# -- Email Config --
# SMTP server host (e.g. smtp.gmail.com)
EMAIL_DOMAIN=smtp.gmail.com
EMAIL_FROM=john.doe@email.com
EMAIL_USERNAME=john.doe@email.com
# Gmail App Password used for SMTP auth (not the account password)
EMAIL_API_KEY=nolodire
EMAIL_PORT=587
FILE_PATH="/files"

# -- Notifier (reminder emails) --
# Daily run time (HH:MM) in NOTIFIER_TIMEZONE
NOTIFIER_RUN_AT=08:00
NOTIFIER_TIMEZONE=America/Caracas
# Remind coordinators of requests under review for at least this long
NOTIFIER_PENDING_REQUEST_AGE=72h
# Remind groups this long before their yearly renewal date
NOTIFIER_RENEWAL_WINDOW=720h
# Wait this long before repeating a reminder to the same recipient
NOTIFIER_RESEND_INTERVAL=168h

# B2 Backblaze
BLACKBLAZE_B2_KEY_ID=mykey
BLACKBLAZE_B2_KEY_NAME=deu-ucv
BLACKBLAZE_B2_APPLICATION_KEY=my-app-key
BLACKBLAZE_B2_BUCKET_NAME=deu-ucv
BLACKBLAZE_B2_ENDPOINT=s3.us-east-005.backblazeb2.com
BLACKBLAZE_B2_REGION=us-east-005
