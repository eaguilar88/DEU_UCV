HTTP_SERVE_PORT=8081
# Public HTTPS base URL for this backend, used to build file/image URLs
# (must resolve to GET /files/*key over HTTPS, e.g. https://api.extension.ucv.ve/files)
# Defaults to http://localhost:8080 if unset — do NOT leave unset in production,
# or served images will point at localhost and fail as mixed content in browsers.
APP_BASE_URL="https://extension.ucv.ve/files"
# Comma-separated list of origins allowed to call this API from a browser (CORS).
# Defaults to http://localhost:3000 for local frontend dev.
# In production, list every frontend origin explicitly — never "*".
ALLOWED_ORIGINS="https://grupos.extension.ucv.ve,https://formacion.extension.ucv.ve"
JWT_SIGNING_KEY="5Sm0wEm+zZBLhiZzGYeAiTehKfgnrgmBOxdOOW2LVL8="
TOKEN_TTL=3600
FLAVOR=dev

# -- Rails Landing (deu-app) --
RAILS_ENV=production
LANDING_PORT=3000
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1
