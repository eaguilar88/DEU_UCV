{
  "info": {
    "name": "DEU UCV API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API collection for DEU UCV — Universidad Central de Venezuela university extension management system."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token obtained from POST /auth/login"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"deu_admin1@example.com\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Authenticate and obtain a JWT token. Store the returned token in the {{token}} variable."
          },
          "response": [
            {
              "name": "200 OK — Success",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJ...\",\n  \"user\": {\n    \"id\": \"1\",\n    \"name\": \"Admin1 Deu\",\n    \"roles\": [\"admin\"]\n  },\n  \"faculty\": \"\",\n  \"codigo_proveedor\": \"\"\n}"
            },
            {
              "name": "401 Unauthorized — Bad credentials",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"invalid credentials\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Providers",
      "item": [
        {
          "name": "List Providers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/providers?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["providers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" },
                { "key": "type", "value": "courses", "disabled": true },
                { "key": "is_active", "value": "true", "disabled": true }
              ]
            },
            "description": "List providers with optional filters: type (courses|groups), party_type, profit_type, is_internal, is_active, code, created_at_from, created_at_to."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"providers\": [\n    {\n      \"id\": \"1\",\n      \"name\": \"Proveedor A\",\n      \"code\": \"ECP-abc123\",\n      \"party_type\": \"natural\",\n      \"profit_type\": \"lucrativo\",\n      \"is_internal\": false,\n      \"is_active\": true,\n      \"facultad\": \"Ingeniería\",\n      \"user\": { \"id\": \"5\", \"email\": \"provider@ucv.ve\" },\n      \"created_at\": \"2025-01-15T10:00:00Z\"\n    }\n  ],\n  \"pagination\": { \"page\": 1, \"per_page\": 10, \"count\": 1 }\n}"
            }
          ]
        },
        {
          "name": "Get Provider by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/providers/1",
              "host": ["{{base_url}}"],
              "path": ["providers", "1"]
            },
            "description": "Get a single provider by numeric ID. Returns provider data including associated files (CI, RIF, ISLR, logo, resumes, intention letter, commitment letters) with pre-signed URLs."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"1\",\n  \"name\": \"Proveedor A\",\n  \"code\": \"ECP-abc123\",\n  \"party_type\": \"natural\",\n  \"profit_type\": \"lucrativo\",\n  \"is_internal\": false,\n  \"is_active\": true,\n  \"facultad\": \"Ingeniería\",\n  \"user\": { \"id\": \"5\", \"email\": \"provider@ucv.ve\", \"first_name\": \"Ana\", \"last_name\": \"Gómez\" },\n  \"created_at\": \"2025-01-15T10:00:00Z\"\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{ \"error\": \"provider not found\" }"
            }
          ]
        },
        {
          "name": "Create Provider",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/providers",
              "host": ["{{base_url}}"],
              "path": ["providers"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "tipo_proveedor", "value": "courses", "type": "text", "description": "courses or groups" },
                { "key": "tipo_persona", "value": "natural", "type": "text", "description": "natural or juridical" },
                { "key": "tipo_lucro", "value": "lucrativo", "type": "text", "description": "lucrativo or no_lucrativo" },
                { "key": "nombre", "value": "Proveedor de Prueba", "type": "text" },
                { "key": "bio", "value": "Breve descripción del proveedor", "type": "text" },
                { "key": "es_interno", "value": "false", "type": "text" },
                { "key": "facultad", "value": "Ingeniería", "type": "text", "description": "faculty_enum value, e.g. Ingeniería, Medicina, Ciencias, DEU" },
                { "key": "ci", "type": "file", "src": "", "description": "Cédula de identidad (required)" },
                { "key": "rif", "type": "file", "src": "", "description": "RIF document (required)" },
                { "key": "islr", "type": "file", "src": "", "description": "ISLR document (required)" },
                { "key": "logo", "type": "file", "src": "", "description": "Provider logo (required)" },
                { "key": "resumes", "type": "file", "src": "", "description": "At least one resume required" },
                { "key": "others", "type": "file", "src": "", "disabled": true, "description": "Additional documents (optional)" }
              ]
            },
            "description": "Register a new provider. All file fields (ci, rif, islr, logo) are required along with at least one resume. Returns the new provider's database ID. A confirmation email is sent to the user's registered email."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"id\": \"42\" }"
            },
            {
              "name": "400 Bad Request — Missing field",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"ci is required\" }"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"error\": \"authentication required\" }"
            },
            {
              "name": "409 Conflict — Duplicate entry",
              "status": "Conflict",
              "code": 409,
              "body": "{ \"error\": \"duplicate entry\" }"
            }
          ]
        },
        {
          "name": "Upload Provider Documents",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/providers/documents",
              "host": ["{{base_url}}"],
              "path": ["providers", "documents"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "carta_compromiso", "type": "file", "src": "", "description": "Commitment letter (required). Auto-versioned: first upload is _v1, second is _v2, etc." },
                { "key": "carta_intencion", "type": "file", "src": "", "disabled": true, "description": "Intention letter (required on first document upload; optional if one already exists in DB)" }
              ]
            },
            "description": "Upload legal documents for the authenticated provider.\n\n- carta_compromiso is always required.\n- carta_intencion is only required if no intention letter exists in the database for this provider.\n- Each commitment letter is versioned automatically (v1, v2, …); the version is appended to the filename.\n- After upload, all provider courses created since the previous commitment letter are automatically marked with has_documentation=true."
          },
          "response": [
            {
              "name": "201 Created — Documents uploaded",
              "status": "Created",
              "code": 201
            },
            {
              "name": "400 Bad Request — Missing carta_compromiso",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"carta_compromiso es requerida\" }"
            },
            {
              "name": "400 Bad Request — No intention letter on file",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"a new provider requires an intention letter\" }"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"error\": \"authentication required\" }"
            },
            {
              "name": "404 Not Found — Provider not found for user",
              "status": "Not Found",
              "code": 404,
              "body": "{ \"error\": \"provider not found\" }"
            }
          ]
        },
        {
          "name": "Update Provider",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/providers/1",
              "host": ["{{base_url}}"],
              "path": ["providers", "1"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "tipo_proveedor", "value": "courses", "type": "text" },
                { "key": "tipo_persona", "value": "natural", "type": "text" },
                { "key": "tipo_lucro", "value": "lucrativo", "type": "text" },
                { "key": "nombre", "value": "Proveedor Actualizado", "type": "text" },
                { "key": "bio", "value": "Nueva descripción", "type": "text" },
                { "key": "es_interno", "value": "false", "type": "text" },
                { "key": "facultad", "value": "Medicina", "type": "text" },
                { "key": "ci", "type": "file", "src": "" },
                { "key": "rif", "type": "file", "src": "" },
                { "key": "islr", "type": "file", "src": "" },
                { "key": "logo", "type": "file", "src": "" },
                { "key": "resumes", "type": "file", "src": "" }
              ]
            }
          },
          "response": [
            {
              "name": "202 Accepted",
              "status": "Accepted",
              "code": 202
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{ \"error\": \"provider not found\" }"
            }
          ]
        },
        {
          "name": "Delete Provider",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/providers/1",
              "host": ["{{base_url}}"],
              "path": ["providers", "1"]
            }
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{ \"error\": \"provider not found\" }"
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User (no profile picture)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"12345678\",\n  \"email\": \"testuser_qa@test.com\",\n  \"nombres\": \"Juan\",\n  \"apellidos\": \"Perez\",\n  \"fecha_de_nacimiento\": \"1-1-1990\",\n  \"genero\": \"masculino\",\n  \"nivel_educativo\": \"universitaria_completa\",\n  \"direccion\": \"Caracas\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a user with JSON body (current deployed behavior). No auth required.\n\nNOTE: Working tree changes this to multipart/form-data — rebuild container to test that version.\n\nValid nivel_educativo values: bachiller, universitaria_incompleta, universitaria_completa, posgrado\nDate format: D-M-YYYY (e.g. 1-1-1990, 15-3-1990)"
          },
          "response": [
            {
              "name": "201 Created — Success",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"42\"\n}"
            },
            {
              "name": "400 Bad Request — Validation failure",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"validation failed\"\n}"
            },
            {
              "name": "400 Bad Request — Invalid date format",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"fecha_de_nacimiento must be in D-M-YYYY format\"\n}"
            },
            {
              "name": "409 Conflict — User already exists",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"user already exists\"\n}"
            },
            {
              "name": "500 Internal Server Error — Email send failure (dev only)",
              "status": "Internal Server Error",
              "code": 500,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"there was an internal error. contact an administrator or try again later\"\n}",
              "_postman_previewlanguage": "json",
              "description": "In local dev, Mailgun sandbox 403s for unauthorized recipients. User IS written to DB before this error."
            }
          ]
        },
        {
          "name": "Create User WITH profile picture (multipart — new code)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "cedula", "value": "87654321", "type": "text" },
                { "key": "email", "value": "testuser_qa2@test.com", "type": "text" },
                { "key": "nombres", "value": "Maria", "type": "text" },
                { "key": "apellidos", "value": "Lopez", "type": "text" },
                { "key": "fecha_de_nacimiento", "value": "15-6-1995", "type": "text" },
                { "key": "genero", "value": "femenino", "type": "text" },
                { "key": "nivel_educativo", "value": "universitaria_completa", "type": "text" },
                { "key": "direccion", "value": "Caracas", "type": "text" },
                { "key": "password", "value": "secret123", "type": "text" },
                { "key": "profile_picture", "type": "file", "src": "", "description": "Optional JPEG/PNG profile picture" }
              ]
            },
            "description": "Create a user with multipart/form-data including an optional profile_picture file.\n\nREQUIRES: Container rebuilt with working tree code (make start-backend).\n\nIf profile_picture is provided and B2 storage credentials are missing, the endpoint returns 500 after creating the user in the DB (same data leak issue as email failure)."
          },
          "response": [
            {
              "name": "201 Created — Success (no picture or picture uploaded)",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"43\"\n}"
            },
            {
              "name": "500 — B2 storage not configured (dev)",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"error\": \"there was an internal error. contact an administrator or try again later\"\n}"
            }
          ]
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "description": "Get a single user by numeric ID. No auth required.\n\nResponse includes foto_perfil (omitempty) — only present when user has a profile picture stored in B2.\n\nNOTE: fecha_de_nacimiento is returned as raw DB timestamp in old code (e.g. '1980-01-01T00:00:00Z'). New code reformats to D-M-YYYY."
          },
          "response": [
            {
              "name": "200 OK — User found (no profile picture)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"1\",\n  \"cedula\": \"101\",\n  \"email\": \"deu_admin1@example.com\",\n  \"nombres\": \"Admin1\",\n  \"apellidos\": \"Deu\",\n  \"fecha_de_nacimiento\": \"1980-01-01T00:00:00Z\",\n  \"genero\": \"male\",\n  \"nivel_educativo\": \"universitaria_completa\",\n  \"direccion\": \"Address 1\",\n  \"creado_en\": \"2025-11-04T21:38:47.084437Z\"\n}"
            },
            {
              "name": "200 OK — User found WITH profile picture",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"42\",\n  \"cedula\": \"12345678\",\n  \"email\": \"testuser_qa@test.com\",\n  \"nombres\": \"Juan\",\n  \"apellidos\": \"Perez\",\n  \"fecha_de_nacimiento\": \"1-1-1990\",\n  \"genero\": \"masculino\",\n  \"nivel_educativo\": \"universitaria_completa\",\n  \"direccion\": \"Caracas\",\n  \"creado_en\": \"2026-03-21T...\",\n  \"foto_perfil\": \"https://s3.us-west-004.backblazeb2.com/...\"\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"user not found\"\n}"
            }
          ]
        },
        {
          "name": "Get Users (list)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "List all users with pagination. Requires JWT auth."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"usuarios\": [...],\n  \"paginas\": { \"page\": 1, \"per_page\": 10, \"total\": 50 }\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": \"invalid or expired authorization token\"\n}"
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primer_nombre\": \"NuevoNombre\",\n  \"apellido\": \"NuevoApellido\",\n  \"fecha_nacimiento\": \"15-6-1990\",\n  \"genero\": \"masculino\",\n  \"nivel_educacion\": \"posgrado\",\n  \"direccion\": \"Nueva Direccion\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update user fields. Note: different JSON field names than POST (ci, primer_nombre, apellido, fecha_nacimiento, nivel_educacion). CI, email, and password are preserved from DB."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "description": "Soft-delete a user. Requires JWT auth."
          }
        }
      ]
    }
  ]
}
