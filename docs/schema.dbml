Project deu_ucv {
  database_type: 'PostgreSQL'
}

Enum education_level_enum {
  bachiller
  universitaria_incompleta
  universitaria_completa
  posgrado
}

Enum faculty_enum {
  "Agronomía"
  "Arquitectura y Urbanismo"
  "Ciencias"
  "Ciencias Económicas y Sociales"
  "Ciencias Jurídicas y Políticas"
  "Ciencias Veterinarias"
  "Farmacia"
  "Humanidades y Educación"
  "Ingeniería"
  "Medicina"
  "Odontología"
  DEU
  NA
}

Enum provider_status_enum {
  under_review
  rejected
  active
  inactive
}

Enum course_location_enum {
  online
  in_site
  mixed
}

Enum course_type_enum {
  unassigned
  skill_development
  life_skills
  technical_training
}

Enum request_status_enum {
  under_review
  rejected
  approved
}

Enum visitante_status_enum {
  approved
  abandoned
  failed
  ongoing
}

Enum contact_type_enum {
  email
  phone
}

Enum owner_type_enum {
  user
  provider
  group
}

Table users {
  id integer [pk, increment]
  ci integer [unique]
  email varchar [unique, not null]
  first_name varchar [not null]
  last_name varchar [not null]
  date_of_birth date
  gender varchar
  education education_level_enum [not null, default: 'bachiller']
  address varchar
  password char(60) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table providers {
  id integer [pk, increment]
  user_id integer [not null]
  name varchar
  party_type varchar
  profit_type varchar [not null]
  is_internal boolean
  bio text
  code varchar
  status provider_status_enum [not null, default: 'under_review']
  faculty faculty_enum
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table roles {
  id integer [pk, increment]
  name varchar [unique, not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp

  Note: 'root, admin, coordinador, facilitador, estudiante, extension'
}

Table user_roles {
  id integer [pk, increment]
  user_id integer [not null]
  role_id integer [not null]
  domain_type varchar [not null, note: 'course | group | all']
  faculty faculty_enum
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp

  indexes {
    (user_id, role_id) [unique]
  }
}

Table courses {
  id integer [pk, increment]
  name varchar
  description text
  provider_id integer [not null]
  objectives text
  rationale text
  duration varchar
  cost varchar
  instructor_profile text
  profiles text
  requirements text
  content text
  evaluation text
  schedule text
  type course_type_enum [default: 'unassigned']
  faculty faculty_enum [default: 'DEU']
  location course_location_enum
  is_active boolean [default: false]
  has_documentation boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table course_auth_requests {
  id integer [pk, increment]
  course_id integer [not null]
  status request_status_enum [not null, default: 'under_review']
  reviewer_id integer
  comments text
  reviewed_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table course_cycles {
